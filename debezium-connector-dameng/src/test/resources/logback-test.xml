<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5p %X{dbz.connectorType}|%X{dbz.connectorName}|%X{dbz.connectorContext} %m [%c]%n</pattern>
        </encoder>
    </appender>
    <root level="warn">
        <appender-ref ref="CONSOLE" />
    </root>
    <logger name="io.debezium.connector.dameng" level="info" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="io.debezium.config.Configuration" level="error" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="org.apache.kafka" level="error" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
</configuration>
