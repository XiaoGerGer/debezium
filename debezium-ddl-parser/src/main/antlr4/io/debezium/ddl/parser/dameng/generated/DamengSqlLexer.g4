// Punctuation and operators retain the native lexer's single-character token contract.
SEMICOLON: ';';
DOT: '.';
COMMA: ',';
LPAREN: '(';
RPAREN: ')';
AMPERSAND: '&';
ASTERISK: '*';
AT_SIGN: '@';
BAR: '|';
CARET: '^';
COLON: ':';
EQUALS_OP: '=';
EXCLAMATION: '!';
GREATER_THAN_OP: '>';
LEFT_BRACKET: '[';
LEFT_CURLY_PAREN: '{';
LESS_THAN_OP: '<';
MINUS_SIGN: '-';
PERCENT: '%';
PLUS_SIGN: '+';
QUESTION_MARK: '?';
RIGHT_BRACKET: ']';
RIGHT_CURLY_PAREN: '}';
SOLIDUS: '/';
TILDE: '~';

// Quoted values, numeric values, and identifiers.
// https://eco.dameng.com/document/dm/zh-cn/pm/dm_sql-introduction.html
// https://eco.dameng.com/document/dm/zh-cn/sql-dev/practice-strings.html
Q_QUOTE_START: 'Q' '\'' { startAlternativeQuote(); } -> more, pushMode(Q_DELIMITER_MODE);
STRING_START: ('N' | 'E')? '\'' -> more, pushMode(STRING_MODE);
IDENTIFIER_START: '"' -> more, pushMode(IDENTIFIER_MODE);
HEX_BINARY_LITERAL: '0X' [0-9A-F]+;
// Consume malformed suffixes as one error, rather than a literal plus an alias.
INVALID_HEX_BINARY_LITERAL: '0X' (Letter | Digit | [_#$])* { fail("Invalid SQL hexadecimal binary literal"); };
NUMBER: Digit+ ('.' Digit*)? ('E' [+-]? Digit+)?;
INVALID_EXPONENT: Digit+ ('.' Digit*)? 'E' [+-]? { fail("Missing SQL numeric exponent"); };
WORD: (Letter | [_#$]) (Letter | Digit | [_#$])*;

// Comments and whitespace do not enter the DDL token stream.
WHITESPACE: Whitespace+ -> skip;
LINE_COMMENT: ('--' | '//') ~[\r\n]* -> skip;
BLOCK_COMMENT_START: '/*' { startComment(); } -> more, pushMode(COMMENT_MODE);
SYMBOL: .;

// Match the existing Java-char token contract while using a code point stream.
fragment Letter: {isBmpLetter()}? .;
fragment Digit: {isBmpDigit()}? .;
fragment Whitespace: {isWhitespace()}? .;

mode COMMENT_MODE;
COMMENT_OPEN: {isNestedComments()}? '/*' { openNestedComment(); } -> more;
COMMENT_CLOSE: '*/' { closeComment(); };
COMMENT_CHARACTER: . -> more;
COMMENT_EOF: EOF { fail("Unclosed SQL comment"); };

mode STRING_MODE;
STRING_ESCAPED_QUOTE: '\'\'' -> more;
STRING_END: '\'' -> type(STRING), popMode;
STRING_CHARACTER: . -> more;
STRING_EOF: EOF { fail("Unclosed SQL quoted value"); };

mode IDENTIFIER_MODE;
IDENTIFIER_ESCAPED_QUOTE: '""' -> more;
IDENTIFIER_END: '"' -> type(IDENTIFIER), popMode;
IDENTIFIER_CHARACTER: . -> more;
IDENTIFIER_EOF: EOF { fail("Unclosed SQL quoted value"); };

mode Q_DELIMITER_MODE;
Q_DELIMITER: . { readAlternativeQuoteDelimiter(); } -> more, mode(Q_STRING_MODE);

mode Q_STRING_MODE;
Q_STRING_END: {isAlternativeQuoteEnd()}? . '\'' -> type(STRING), popMode;
Q_STRING_CHARACTER: . -> more;
Q_STRING_EOF: EOF { fail("Unclosed SQL alternative quoted value"); };
