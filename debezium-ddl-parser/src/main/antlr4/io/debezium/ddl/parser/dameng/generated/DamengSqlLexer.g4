lexer grammar DamengSqlLexer;

options {
    superClass = DamengSqlLexerBase;
    caseInsensitive = true;
}

tokens {
    STRING, IDENTIFIER
}

@header {
    import io.debezium.ddl.parser.dameng.DamengSqlLexerBase;
}

